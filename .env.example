# Copy to .env and fill in ONE provider key. Never commit .env.
LLM_PROVIDER=            # openai | anthropic (optional: auto-detected from the key you set)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=               # optional: overrides the default model of the chosen provider

# Optional: pin "now" to make runs reproducible (store time zone: America/Campo_Grande)
# AGENT_NOW=2026-03-25T10:30:00
